<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Top 20 Digital Skills - LearnWithZia</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="icon" href="/Favi.jpeg"> <!-- Sample favicon -->

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Nunito:wght@400;700&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        /* Font Styles */
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f0f4f8;
            animation: fadeIn 1s ease-in-out;
        }

        h4, .navbar-brand, .nav-link {
            font-family: 'Lato', sans-serif;
        }

        .header {
            background-color: #382893;
            color: #fff;
            padding: 20px 0;
            animation: fadeIn 1s ease-in-out;
        }

        .course-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
            margin-top: 40px;
        }

        .course-box {
            background-color: #ffffff;
            border: 1px solid #000;
            border-radius: 10px;
            width: 250px;
            padding: 20px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .course-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(23, 0, 66, 0.2);
        }

        .course-image {
            width: 100px;
            height: auto;
            margin-bottom: 10px;
        }

        .available {
            color: green;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 10px;
        }

        .available i {
            margin-right: 5px;
        }

        footer {
            background-color: #f8f9fa;
            padding: 20px 0;
            animation: fadeIn 2s ease-in-out;
        }

        footer a:hover {
            color: #513e2b;
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <header class="header">
        <div class="container text-center">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container">
                    <a class="navbar-brand" href="#">LearnWithZia</a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ml-auto">
                            <li class="nav-item active">
                                <a class="nav-link" href="index.html">Home<span class="sr-only">(current)</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="course.html">Courses</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="about.html">About Us</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="contact.html">Contact</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Section -->
    <div class="container">
        <h4 class="text-center mb-4">Explore the Top 20 Digital Skills</h4>
        <div class="course-container">
            <div class="course-box">
                <img src="https://via.placeholder.com/100.png?text=Digital+Marketing" alt="Digital Marketing" class="course-image">
                <h5>Digital Marketing</h5>
                <div class="available"><i class="fas fa-check-circle"></i> Available</div>
            </div>
            <div class="course-box">
                <img src="https://via.placeholder.com/100.png?text=Web+Development" alt="Web Development" class="course-image">
                <h5>Web Development</h5>
                <div class="available"><i class="fas fa-check-circle"></i> Available</div>
            </div>
            <div class="course-box">
                <img src="https://via.placeholder.com/100.png?text=Graphic+Design" alt="Graphic Design" class="course-image">
                <h5>Graphic Designing</h5>
                <div class="available"><i class="fas fa-check-circle"></i> Available</div>
            </div>
            <div class="course-box">
                <img src="https://via.placeholder.com/100.png?text=SEO" alt="SEO" class="course-image">
                <h5>SEO Optimization</h5>
            </div>
            <div class="course-box">
                <img src="https://via.placeholder.com/100.png?text=Content+Creation" alt="Content Creation" class="course-image">
                <h5>Content Creation</h5>
            </div>
            <div class="course-box">
                <img src="https://via.placeholder.com/100.png?text=Social+Media" alt="Social Media" class="course-image">
                <h5>Social Media Management</h5>
            </div>
            <!-- Add more course boxes here -->
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center">
        <div class="container">
            <p>&copy; 2024 LearnWithZia. All rights reserved.</p>
            <p>Stay tuned for upcoming courses on these skills!</p>
        </div>
    </footer>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</body>

</html>
